<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<document type="com.apple.InterfaceBuilder3.CocoaTouch.Storyboard.XIB" version="3.0" toolsVersion="12121" systemVersion="16G29" targetRuntime="iOS.CocoaTouch" propertyAccessControl="none" useAutolayout="YES" launchScreen="YES" colorMatched="YES" initialViewController="01J-lp-oVM">
    <dependencies>
        <deployment identifier="iOS"/>
        <plugIn identifier="com.apple.InterfaceBuilder.IBCocoaTouchPlugin" version="12089"/>
    </dependencies>
    <!--
      Pantalla de arranque nativa. No es decoración: es el primer fotograma
      que ve el usuario y tiene que ser indistinguible del primero que dibuja
      Flutter, o el arranque parpadea.

      El fondo es la malla de color del splash (`fondo_malla.dart`), como
      imagen estirada a toda la pantalla: `FondoMalla` sale del mismo
      pintor y `test/fondo_malla_nativo_test.dart` avisa si se separan. El
      color de debajo es el del centro de la malla, por si la imagen tarda. El logo mide 84 pt y se centra 72,5 pt por encima
      del centro: es exactamente donde lo deja el splash
      (`splash_screen.dart`, `InkHero(logoSize: 84)` dentro de una columna
      centrada con el wordmark, la tagline y el indicador debajo). Medido
      sobre `test/golden/goldens/ink_hero_splash.png`: el disco cae entre
      y=308 y y=391 en una pantalla de 844.
    -->
    <scenes>
        <!--View Controller-->
        <scene sceneID="EHf-IW-A2E">
            <objects>
                <viewController id="01J-lp-oVM" sceneMemberID="viewController">
                    <layoutGuides>
                        <viewControllerLayoutGuide type="top" id="Ydg-fD-yQy"/>
                        <viewControllerLayoutGuide type="bottom" id="xbc-2k-c8Z"/>
                    </layoutGuides>
                    <view key="view" contentMode="scaleToFill" id="Ze5-6b-2t3">
                        <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                        <subviews>
                            <imageView userInteractionEnabled="NO" contentMode="scaleToFill" image="FondoMalla" translatesAutoresizingMaskIntoConstraints="NO" id="Mal-la-Fdo">
                            </imageView>
                            <imageView opaque="NO" clipsSubviews="YES" multipleTouchEnabled="YES" contentMode="center" image="LaunchImage" translatesAutoresizingMaskIntoConstraints="NO" id="YRO-k0-Ey4">
                            </imageView>
                        </subviews>
                        <color key="backgroundColor" red="0.039215686274509803" green="0.43137254901960786" blue="0.40000000000000002" alpha="1" colorSpace="custom" customColorSpace="sRGB"/>
                        <constraints>
                            <constraint firstItem="Mal-la-Fdo" firstAttribute="top" secondItem="Ze5-6b-2t3" secondAttribute="top" id="Mt1-Fd-Top"/>
                            <constraint firstItem="Mal-la-Fdo" firstAttribute="bottom" secondItem="Ze5-6b-2t3" secondAttribute="bottom" id="Mt2-Fd-Bot"/>
                            <constraint firstItem="Mal-la-Fdo" firstAttribute="leading" secondItem="Ze5-6b-2t3" secondAttribute="leading" id="Mt3-Fd-Lea"/>
                            <constraint firstItem="Mal-la-Fdo" firstAttribute="trailing" secondItem="Ze5-6b-2t3" secondAttribute="trailing" id="Mt4-Fd-Tra"/>
                            <constraint firstItem="YRO-k0-Ey4" firstAttribute="centerX" secondItem="Ze5-6b-2t3" secondAttribute="centerX" id="1a2-6s-vTC"/>
                            <constraint firstItem="YRO-k0-Ey4" firstAttribute="centerY" secondItem="Ze5-6b-2t3" secondAttribute="centerY" constant="-72.5" id="4X2-HB-R7a"/>
                        </constraints>
                    </view>
                </viewController>
                <placeholder placeholderIdentifier="IBFirstResponder" id="iYj-Kq-Ea1" userLabel="First Responder" sceneMemberID="firstResponder"/>
            </objects>
            <point key="canvasLocation" x="53" y="375"/>
        </scene>
    </scenes>
    <resources>
        <image name="FondoMalla" width="390" height="844"/>
        <image name="LaunchImage" width="84" height="84"/>
    </resources>
</document>
