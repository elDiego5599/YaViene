<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12 en adelante: la misma exclusión, para las dos vías por las que
  los datos salen del teléfono. `cloud-backup` es la copia a la cuenta de
  Google; `device-transfer` es el paso directo a un teléfono nuevo. El
  motivo, largo, está en backup_rules.xml.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="FlutterSharedPreferences.xml"/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="FlutterSharedPreferences.xml"/>
    </device-transfer>
</data-extraction-rules>
