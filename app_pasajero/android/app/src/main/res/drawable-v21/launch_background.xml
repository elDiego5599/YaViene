<?xml version="1.0" encoding="utf-8"?>
<!-- Copia de drawable/launch_background.xml: este calificador (v21) tapa al
     genérico en todos los dispositivos, porque minSdk es 24. Si tocas uno,
     toca el otro. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/splash_background" />
<!-- 84dp y no 128: es el tamaño exacto al que el splash de Flutter dibuja
     el logo (`InkHero(logoSize: 84)`). Y `bottom=145dp` lo sube 72,5dp sobre
     el centro —la mitad del hueco— porque en el splash el logo encabeza una
     columna centrada con el nombre, la tagline y el indicador debajo. Con el
     tamaño y el sitio de antes, el relevo entre la pantalla nativa y la de
     Flutter se veía como un salto del logo. -->
    <item
        android:gravity="center"
        android:width="84dp"
        android:height="84dp"
        android:bottom="145dp"
        android:drawable="@drawable/ic_splash_logo" />
</layer-list>
