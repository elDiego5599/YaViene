// Application-level settings for the Runner target.
//
// This may be replaced with something auto-generated from metadata (e.g., pubspec.yaml) in the
// future. If not, the values below would default to using the project name when this becomes a
// 'flutter create' template.

// The application's name. By default this is also the title of the Flutter window.
PRODUCT_NAME = Ya Viene Control

// The application's bundle identifier
PRODUCT_BUNDLE_IDENTIFIER = co.yaviene.yaVieneControl

// The copyright displayed in application information
PRODUCT_COPYRIGHT = Copyright © 2026 co.yaviene. All rights reserved.

// La firma de este Mac, si existe (Firma.local.xcconfig, fuera de git). Sin
// ella la app sale «ad hoc» y el llavero la trata como una app nueva en cada
// build: pregunta la contraseña una vez por entrada cada vez que se compila
// (dueño, 2026-09-30). Con un certificado de equipo la reconoce siempre.
// Opcional para que la CI, que no tiene certificado, compile igual.
#include? "Firma.local.xcconfig"
